rules_version = '2';
// ME2: cada usuario lee su propio documento y solo edita campos de perfil.
// Plan, vencimiento, contadores, prueba, verificación de edad, cupos y lista
// de espera los escribe únicamente el servidor (Admin SDK, que ignora reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Campos que el cliente puede tocar. Todo lo demás es del servidor.
    function profileKeys() { return ['displayName', 'avatarPrefs', 'locale']; }
    function validProfile(d) {
      return (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 60))
          && (!('avatarPrefs' in d) || (d.avatarPrefs is map && d.avatarPrefs.size() <= 20))
          && (!('locale' in d) || (d.locale is string && d.locale.size() <= 10));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      // Alta: solo campos de perfil; el servidor completa el resto.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileKeys())
        && validProfile(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
        && validProfile(request.resource.data);
      allow delete: if false;

      // Memorias (incluye las de la prueba): lectura propia, escritura del servidor.
      match /memories/{memId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }
    }

    // Exclusivo del servidor: pagos, cupos, lista de espera, links, contadores, config.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
