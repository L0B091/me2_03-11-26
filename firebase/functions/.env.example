# Copiar a .env (NO commitear). Los secretos van con `firebase functions:secrets:set`.
LOCAL_AI_URL=https://tu-tunel.example.com/v1/chat/completions
LOCAL_AI_MODEL=qwen3-vl
LOCAL_AI_TIMEOUT_MS=30000
PUBLIC_BASE_URL=https://me2-app-ar.web.app
# Secretos: MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET, LOCAL_AI_KEY
# Personalidad (prompt fijo + línea [ESTADO] + filtro de salida). Desactivado hasta tener la IA local lista.
USE_PERSONALITY_PROMPT=false
PERSONAJE_NOMBRE=ME2
